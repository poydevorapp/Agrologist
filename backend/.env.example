NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGIN=http://localhost:3001

# For hosted PostgreSQL, set DATABASE_URL and leave the individual DB_* credentials unset.
# DATABASE_URL=postgresql://user:password@host:5432/database
# For providers requiring TLS, set DB_SSL=true. Keep certificate verification enabled
# unless the provider explicitly documents that its certificate cannot be verified.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agro_marketplace
DB_USER=postgres
# Replace locally. Never commit real credentials. Use a limited app role later.
DB_PASSWORD=replace_with_local_password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
